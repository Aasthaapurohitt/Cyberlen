# MongoDB Atlas quick setup:
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Database Access -> add a user with a password
# 3. Network Access -> add your IP (or 0.0.0.0/0 for a class demo — not for real prod)
# 4. Cluster -> Connect -> Drivers -> copy the connection string and paste below,
#    swapping in your username/password and a database name (e.g. "cyberlens")
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/cyberlens
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=8000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# Add your dashboard's deployed URL and, once packaged, your extension's
# chrome-extension://<id> origin.
ALLOWED_ORIGINS=http://localhost:5173
